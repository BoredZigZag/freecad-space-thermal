{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fcst:cad-mesh:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "brep_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "ref": {
                "type": "string",
                "pattern": "^Face[1-9][0-9]*$"
              },
              "signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "area_m2": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "ref",
              "signature",
              "area_m2"
            ]
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "revision",
        "brep_sha256",
        "signature",
        "faces"
      ]
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mesher_version": {
      "const": "4.15.0"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            2,
            3
          ]
        },
        "maximum_size_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_size_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "order": {
          "const": 1
        },
        "threads": {
          "const": 1
        },
        "algorithm_2d": {
          "const": 5
        },
        "algorithm_3d": {
          "const": 1
        },
        "random_seed": {
          "const": 1
        },
        "optimize": {
          "const": false
        }
      },
      "required": [
        "dimension",
        "maximum_size_m",
        "minimum_size_m",
        "order",
        "threads",
        "algorithm_2d",
        "algorithm_3d",
        "random_seed",
        "optimize"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "position_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "tag",
          "position_m"
        ]
      },
      "minItems": 3,
      "maxItems": 16384
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "topology": {
            "enum": [
              "tri3",
              "tet4"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 3,
            "maxItems": 4,
            "uniqueItems": true
          },
          "region": {
            "type": "string",
            "pattern": "^(Solid|Face)[1-9][0-9]*$"
          }
        },
        "required": [
          "tag",
          "topology",
          "nodes",
          "region"
        ]
      },
      "minItems": 1,
      "maxItems": 32768
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true
          },
          "cad_face_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "tag",
          "nodes",
          "cad_face_id"
        ]
      },
      "minItems": 1,
      "maxItems": 32768
    }
  },
  "required": [
    "contract_version",
    "geometry",
    "profile_sha256",
    "mesher_version",
    "options",
    "nodes",
    "cells",
    "facets"
  ]
}
