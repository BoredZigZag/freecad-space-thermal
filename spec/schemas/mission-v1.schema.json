{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fcst:contract:mission:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sun_direction_inertial": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "maximum_interval_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attitude": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "time_s": {
                "type": "number"
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "time_s",
              "rotation"
            ]
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "orbit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "body_radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gravitational_parameter_m3_s2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "phase_rad": {
              "type": "number"
            },
            "plane_to_inertial": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "radius_m",
            "body_radius_m",
            "gravitational_parameter_m3_s2",
            "phase_rad",
            "plane_to_inertial"
          ]
        },
        "albedo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "body_exitance_W_m2": {
          "type": "number",
          "minimum": 0
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "facets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "minItems": 1,
                "maxItems": 4096,
                "uniqueItems": true
              },
              "pivot_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "axis": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "angles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "time_s": {
                      "type": "number"
                    },
                    "angle_rad": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "time_s",
                    "angle_rad"
                  ]
                },
                "minItems": 1,
                "maxItems": 4096
              }
            },
            "required": [
              "id",
              "facets",
              "pivot_m",
              "axis",
              "angles"
            ]
          },
          "maxItems": 4096
        },
        "case_optics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "facet_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "solar_absorptance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ir_emittance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "condition": {
                "enum": [
                  "BOL",
                  "EOL",
                  "unspecified"
                ]
              }
            },
            "required": [
              "facet_id",
              "solar_absorptance",
              "ir_emittance",
              "condition"
            ]
          },
          "maxItems": 4096
        }
      },
      "required": [
        "sun_direction_inertial",
        "maximum_interval_s",
        "attitude"
      ]
    }
  },
  "required": [
    "contract_version",
    "project_id",
    "case_id",
    "mission"
  ]
}
